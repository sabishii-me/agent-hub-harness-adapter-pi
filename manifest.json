{
  "id": "pi",
  "icons": {
    "light": "logo-light.svg",
    "dark": "logo-dark.svg"
  },
  "version": "0.1.9",
  "protocol": 0,
  "command": [
    "node",
    "pi-adapter.cjs"
  ],
  "runtime": {
    "package": "@earendil-works/pi-coding-agent",
    "version": "1.0.0",
    "command": [
      "node",
      "runtime/dist/cli.js"
    ]
  },
  "extensions": [
    "agent-presets",
    "plan"
  ],
  "capabilities": [
    "models",
    "runtime",
    "presets",
    "plan",
    "review",
    "fork",
    "stats",
    "compact",
    "rename",
    "skills",
    "history-readonly"
  ],
  "pluginType": "harness-adapter",
  "name": "Pi",
  "summary": "A coding-agent harness: the official pi runtime, driven over its own headless protocol.",
  "release": {
    "repository": "sabishii-me/agent-hub-harness-adapter-pi",
    "exclude": [
      "runtime/docs",
      "runtime/examples"
    ]
  }
}
